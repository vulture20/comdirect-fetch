# Vorlage für die Umgebungsvariablen des Fetch-Diensts (KONZEPT.md Abschnitt 4).
# Kopieren nach .env und echte Werte eintragen. .env selbst NICHT committen.

# comdirect-Zugangsdaten (Nutzer-Ebene, KONZEPT.md Abschnitt 3)
Comdirect__BaseUrl=https://api.comdirect.de
Comdirect__ClientId=
Comdirect__ClientSecret=
Comdirect__Username=
Comdirect__Password=

# Optional: Base64-kodierter 32-Byte-AES-256-Schlüssel, um den Session-Token verschlüsselt
# in der DB zu persistieren, damit ein Neustart innerhalb der Token-Gültigkeit keine neue
# TAN-Freigabe braucht (KONZEPT.md Abschnitt 3/9). Erzeugen mit: openssl rand -base64 32
# Leer lassen, um die Persistierung zu deaktivieren (Verhalten wie vor 0.11.0).
Comdirect__TokenEncryptionKeyBase64=

# Datenbank (extern bereitgestellte MariaDB, KONZEPT.md Abschnitt 2)
Database__Host=
Database__Port=3306
Database__Name=
Database__User=
Database__Password=

# Abruf-Steuerung (Sekunden). Der Token-Refresh sollte deutlich unter der ~10-Minuten-
# Gültigkeit des Access-Tokens bleiben (KONZEPT.md Abschnitt 3).
Fetch__TokenRefreshIntervalSeconds=480
Fetch__BalancesIntervalSeconds=900
Fetch__PortfolioIntervalSeconds=3600
Fetch__TransactionsIntervalSeconds=900

# Allgemein
Logging__LogLevel__Default=Information
TZ=Europe/Berlin
