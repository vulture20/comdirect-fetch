# Vorlage für die Umgebungsvariablen des Fetch-Diensts (KONZEPT.md Abschnitt 4).
# Kopieren nach .env und echte Werte eintragen. .env selbst NICHT committen.

# comdirect-Zugangsdaten (Nutzer-Ebene, KONZEPT.md Abschnitt 3)
Comdirect__BaseUrl=https://api.comdirect.de

# Client-ID/Client-Secret werden seit 0.12.0 primär über Docker-Compose-Secrets bereitgestellt
# (KONZEPT.md Abschnitt 10 A) - vor dem ersten Start secrets/Comdirect__ClientId und
# secrets/Comdirect__ClientSecret anlegen (siehe README.md). Hier als Fallback nur für lokale
# Entwicklung ohne Docker Compose nützlich; wenn die Secret-Dateien existieren, haben sie Vorrang.
Comdirect__ClientId=
Comdirect__ClientSecret=

# Zugangsnummer/PIN: nur als Fallback nötig, solange kein Bootstrap über POST /admin/credentials
# durchgeführt wurde (KONZEPT.md Abschnitt 10 B). Nach dem Bootstrap hier leeren - siehe README.md.
Comdirect__Username=
Comdirect__Password=

# Optional: Pfad zur Schlüsseldatei für den Bootstrap-Mechanismus (KONZEPT.md Abschnitt 10 B).
# Standard passt zum Bind-Mount in docker/docker-compose.yml, i. d. R. nicht ändern.
# Comdirect__CredentialKeyFilePath=/run/secrets/credential_key

# Optional: Base64-kodierter 32-Byte-AES-256-Schlüssel, um den Session-Token verschlüsselt
# in der DB zu persistieren, damit ein Neustart innerhalb der Token-Gültigkeit keine neue
# TAN-Freigabe braucht (KONZEPT.md Abschnitt 3/9). Erzeugen mit: openssl rand -base64 32
# Leer lassen, um die Persistierung zu deaktivieren (Verhalten wie vor 0.11.0). Bewusst ein
# eigener Schlüssel, unabhängig vom Bootstrap-Schlüssel oben (KONZEPT.md Abschnitt 10).
Comdirect__TokenEncryptionKeyBase64=

# Datenbank (extern bereitgestellte MariaDB, KONZEPT.md Abschnitt 2)
Database__Host=
Database__Port=3306
Database__Name=
Database__User=
Database__Password=

# Abruf-Steuerung (Sekunden). Der Token-Refresh sollte deutlich unter der ~10-Minuten-
# Gültigkeit des Access-Tokens bleiben (KONZEPT.md Abschnitt 3).
Fetch__TokenRefreshIntervalSeconds=480
Fetch__BalancesIntervalSeconds=900
Fetch__PortfolioIntervalSeconds=3600
Fetch__TransactionsIntervalSeconds=900

# Konsolidierungs-/Aufräumprozess (KONZEPT.md Abschnitt 11). Komplett opt-in - ohne gesetzte
# Tage-Werte passiert nichts (heutiges Verhalten bleibt: alles wird für immer aufbewahrt).
# Retention__IntervalSeconds=86400
#
# Rohdaten-Frist (Tage) für account_balances/portfolio_snapshots: Zeilen älterer Tage werden auf
# 1 Wert/Tag reduziert (der letzte Wert des Tages bleibt erhalten).
# Retention__RawDataRetentionDays=90
#
# Zusätzliche Frist (Tage), nach der bereits konsolidierte (1 Wert/Tag) Zeilen komplett gelöscht
# werden - Gesamtalter ab jetzt = RawDataRetentionDays + ConsolidatedDataRetentionDays. Nur
# wirksam, wenn RawDataRetentionDays ebenfalls gesetzt ist.
# Retention__ConsolidatedDataRetentionDays=365
#
# Frist (Tage) für das Löschen alter sync_log-Zeilen, unabhängig von den beiden Werten oben.
# Retention__SyncLogRetentionDays=90

# Benachrichtigung, wenn eine neue TAN-Freigabe erforderlich wird (KONZEPT.md Abschnitt 3,
# GitHub-Issue #6). Zwei unabhängige, komplett opt-in nutzbare Kanäle - beide gleichzeitig
# aktivierbar. Ohne Konfiguration bleibt es beim bisherigen, rein passiven Verhalten
# (comdirectctl.sh status / sync_log). Testen mit: comdirectctl.sh notify-test
#
# E-Mail (SMTP):
# Notification__EmailSmtpHost=
# Notification__EmailSmtpPort=587
# Notification__EmailSmtpUser=
# Notification__EmailSmtpPassword=
# Notification__EmailUseStartTls=true
# Notification__EmailFrom=
# Notification__EmailTo=            # kommagetrennt bei mehreren Empfängern
#
# Webhook (beliebiger HTTP-Endpunkt, z. B. ntfy.sh, Home Assistant, n8n/Node-RED):
# Notification__WebhookUrl=

# Allgemein
Logging__LogLevel__Default=Information
TZ=Europe/Berlin
